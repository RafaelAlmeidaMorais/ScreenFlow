generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  users          User[]
  screens        Screen[]
  medias         Media[]
  auditLogs      AuditLog[]
  playbackEvents PlaybackEvent[]
  deviceTokens   DeviceToken[]

  @@map("companies")
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  email        String     @unique
  name         String
  password     String
  role         String     @default("VIEWER")
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  company      Company    @relation(fields: [companyId], references: [id])
  medias       Media[]    @relation("CreatedByUser")
  auditLogs    AuditLog[]

  @@map("users")
}

model Screen {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  slug               String    @unique
  description        String?
  token              String    @unique @default(uuid())
  intervalSeconds    Int       @default(10)
  isActive           Boolean   @default(true)
  lastSeenAt         DateTime?
  refreshRequestedAt DateTime?
  autoRefreshMinutes Int       @default(360)
  showProgressBar    Boolean   @default(true)
  orientation        String    @default("LANDSCAPE")
  aspectRatio        String    @default("AUTO")
  layoutTemplate     String    @default("FULLSCREEN")
  customLayout       Json?
  outputMapping      Json?
  offlineEnabled     Boolean   @default(false)
  offlineStatus      Json?
  createdAt          DateTime  @default(now())
  company            Company   @relation(fields: [companyId], references: [id])
  medias             Media[]
  widgets            ScreenWidget[]
  playbackEvents     PlaybackEvent[]
  deviceTokens       DeviceToken[]

  @@map("screens")
}

model ScreenWidget {
  id         String   @id @default(cuid())
  screenId   String
  companyId  String
  slot       String   @default("main")
  type       String
  config     Json
  orderIndex Int      @default(0)
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, slot])
  @@index([companyId])
  @@map("screen_widgets")
}

model Media {
  id              String    @id @default(cuid())
  screenId        String
  companyId       String
  type            String    @default("IMAGE")
  fileUrl         String
  title           String
  durationSeconds Int       @default(10)
  orderIndex      Int       @default(0)
  slot            String    @default("main")
  startDate       DateTime  @default(now())
  endDate         DateTime?
  isEnabled       Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  screen          Screen    @relation(fields: [screenId], references: [id])
  company         Company   @relation(fields: [companyId], references: [id])
  createdBy       User      @relation("CreatedByUser", fields: [createdById], references: [id])
  playbackEvents  PlaybackEvent[]

  @@map("medias")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id            String    @id @default(cuid())
  code          String?   @unique
  codeExpiresAt DateTime?
  screenId      String?
  companyId     String?
  name          String?
  userAgent     String?
  lastSeenAt    DateTime?
  pairedAt      DateTime?
  createdAt     DateTime  @default(now())
  screen        Screen?   @relation(fields: [screenId], references: [id], onDelete: SetNull)
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([screenId])
  @@index([companyId])
  @@map("device_tokens")
}

model PlaybackEvent {
  id         String   @id @default(cuid())
  mediaId    String
  screenId   String
  companyId  String
  playedAt   DateTime @default(now())
  durationMs Int?
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, playedAt])
  @@index([mediaId, playedAt])
  @@index([screenId, playedAt])
  @@map("playback_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
